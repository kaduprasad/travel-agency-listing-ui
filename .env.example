# Supabase (https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key   # server-only, never expose

# Default agency this deployment serves (slug from agencies.slug)
NEXT_PUBLIC_DEFAULT_AGENCY_SLUG=skyline-travels

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@skylinetravels.example

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
